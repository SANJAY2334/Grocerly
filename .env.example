# ==============================================================================
# Grocerly Environment Configuration Template
# ==============================================================================

# Application Environment (development, test, production)
NODE_ENV=development
PORT=3000

# Base URL (used for origin verification & absolute email links)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas Connection
# In local development without MongoDB, the engine gracefully operates in high-fidelity mock/test mode
MONGODB_URI=mongodb://localhost:27017/grocerly
MONGODB_DB_NAME=grocerly

# Cryptographic Session & Token Signing Secret (min 32 characters in production)
# Generate a cryptographically secure random string using: openssl rand -hex 32
AUTH_SECRET=replace_with_cryptographically_strong_random_secret_min_32_characters

# Session & Challenge Lifespans
SESSION_TTL_SECONDS=604800
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_SECONDS=900

# Transactional Email (Nodemailer SMTP)
# When omitted or running in test mode, the application uses an in-memory test transporter
# that logs email dispatch safely without false errors.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Grocerly <noreply@grocerly.in>"
SMTP_FROM="Grocerly <noreply@grocerly.in>"
SMTP_SECURE=false

# Razorpay Payment Gateway (Optional)
# When unconfigured, the application honestly informs customers that live online payment
# is unavailable and directs them to Cash on Delivery (COD) without fabricating transactions.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Persistence Mode
# Set to "true" to force isolated in-memory storage during automated testing
GROCERLY_TEST_IN_MEMORY=false

# Rate Limiting
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
